# PaperIntelligence environment example (worktree: worktrees/subha)
# Copy values into your shell or a local .env that tools may load.
# Do NOT put PG_DSN in a dotenv file loaded before the PG_DSN guard.

# Models — keep screen/classify pins unless Subha explicitly changes them.
# Quality model is date-mapped in policies/quality_models/v001.yaml
# (Sol before 2026-09-16, Terra from cutover). Leave QUALITY_MODEL unset
# unless you intentionally override for a one-off run (loud warning if it
# disagrees with the mapping).
SCREEN_MODEL=z-ai/glm-5.3-flash
CLASSIFY_MODEL=z-ai/glm-5.3-flash
# QUALITY_MODEL=openai/gpt-5.6-sol   # one-off override only
# QUALITY_MODEL=openai/gpt-5.6-terra

# Quality router top-slice scope: window (default) | day (per UTC published_at).
# ROUTER_PERCENTILE_SCOPE=window

# Optional cumulative paid-stage budget (USD). Also accepted as --max-cost-usd.
# PI_MAX_COST_USD=10

# Optional per-model price overrides (USD per million tokens) when a model is
# not in the verified defaults. Both IN and OUT are required for unknown models.
# PI_PRICE_Z_AI_GLM_4_6_IN=...
# PI_PRICE_Z_AI_GLM_4_6_OUT=...
